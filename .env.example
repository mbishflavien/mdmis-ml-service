# Shared secret both directions of backend<->ML-service traffic must send.
# Must match ML_SERVICE_API_KEY in the backend's own .env.
SERVICE_API_KEY=change-me-to-a-long-random-string

MODEL_VERSION=v1

# MDMIS_BACKEND- API base, used by scripts/retrain.py to pull lab_confirmed
# MineralZone labels for retraining.
BACKEND_URL=http://localhost:8000/api
